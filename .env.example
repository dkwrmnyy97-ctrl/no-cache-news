# Copy to .env and fill in. Never commit .env.
# Anthropic API key — briefings, chat, podcast matching. Without it the server
# falls back to keyword-based briefings.
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI API key — server-side text-to-speech for "Read Aloud" (optional;
# the client falls back to browser speech synthesis).
OPENAI_API_KEY=your-openai-api-key
PORT=3001
# Bearer token for POST /api/refresh (admin cache flush). The route returns 503
# until this is set.
NEWS_ADMIN_TOKEN=generate-a-long-random-string
# Optional /api/chat limits (defaults shown).
# CHAT_MAX_QUERY_CHARS=500
# CHAT_PER_IP_PER_MINUTE=5
# CHAT_PER_IP_PER_DAY=40
# CHAT_DAILY_CAP=300
# CHAT_MAX_CONCURRENT=3
