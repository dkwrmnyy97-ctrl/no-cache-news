# Copy to .env and fill in. Never commit .env.
# Anthropic API key — briefings, chat, podcast matching. Without it the server
# falls back to keyword-based briefings.
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI API key — server-side text-to-speech for "Read Aloud" (optional;
# the client falls back to browser speech synthesis).
OPENAI_API_KEY=your-openai-api-key
PORT=3001
